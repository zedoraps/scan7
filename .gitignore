# Python
ml/.venv/
__pycache__/
*.pyc

# Generated ML outputs
ml/out/
ml/runs/
*.pt
*.tflite
# The app's bundled detector (app/app/src/main/assets/model.tflite) is NOT tracked: recreate it with
# `cd ml && uv run scripts/export.py <checkpoint>` (~10 MB per version would bloat git history).

# Android
app/.gradle/
app/.kotlin/
app/build/
app/*/build/
app/local.properties
app/.idea/
*.iml
.DS_Store

# Photo data: too large for git, contains private photos (PRIVATE_*). Index lives in ml/data/manifest.csv
ml/data/**/*.jpg
ml/data/**/*.jpeg
ml/data/**/*.png
*.zip

# Label Studio runtime state (database, media, credentials)
ml/labeling/ls_data/

# Training logs
ml/*.log
