# Python
ml/.venv/
__pycache__/
*.pyc

# Generated ML outputs
ml/out/
ml/runs/
*.pt
*.tflite
# The app's bundled detector (app/app/src/main/assets/model.tflite) is NOT tracked: recreate it with
# `cd ml && uv run scripts/export.py <checkpoint>` or fetch the released one with `cd app && ./gradlew downloadModel`
# (~10 MB per version would bloat git history).

# Android
app/.gradle/
app/.kotlin/
app/build/
app/*/build/
app/local.properties
app/.idea/
*.iml
.DS_Store

# Photo data: too large for git and partly private; the local index ml/data/manifest.csv stays out too
ml/data/manifest.csv
ml/data/**/*.jpg
ml/data/**/*.jpeg
ml/data/**/*.png
*.zip

# Label Studio runtime state (database, media, credentials)
ml/labeling/ls_data/

# Training logs
ml/*.log

# Local agent tooling (worktrees, settings); only the CLAUDE.md pointer to AGENTS.md is shared
.claude/*
!.claude/CLAUDE.md
!.claude/skills

# Raw app scans pulled from the phone (images + JSON sidecars)
ml/data/app_scans/

# App screenshot matrix (scripts/screen-matrix.sh)
/out/

# Release upload keys (they belong in ~/keys, never in the repo)
*.jks
*.keystore
# downloadModel temp file
*.tflite.part

# Play screenshots (scripts/store-screenshots.sh): regenerated before each listing update
docs/store/screenshots/

# Photos the user must review/delete (private content); never commit or sync.
ml/data/quarantine/
