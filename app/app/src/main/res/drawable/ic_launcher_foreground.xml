<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground, hand-converted from brand/ic_launcher_foreground.svg (108 x 108 canvas).
    SVG: translate(18 18) scale(0.72) > rotate(-8 50 50) > card, "7" stroke, scan line.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <group
            android:pivotX="50"
            android:pivotY="50"
            android:rotation="-8">
            <!-- Card: rect x=30 y=20 w=40 h=60 rx=7 -->
            <path
                android:fillColor="@color/scan7_ground"
                android:pathData="M37,20 H63 A7,7 0 0 1 70,27 V73 A7,7 0 0 1 63,80 H37 A7,7 0 0 1 30,73 V27 A7,7 0 0 1 37,20 Z" />
            <!-- The 7 -->
            <path
                android:pathData="M42,35 h16 l-9,25"
                android:strokeColor="@color/scan7_accent"
                android:strokeWidth="8.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- Scan line: rect x=12 y=67.5 w=76 h=7 rx=3.5, ground-colored outline -->
            <path
                android:fillColor="@color/scan7_text"
                android:pathData="M15.5,67.5 H84.5 A3.5,3.5 0 0 1 84.5,74.5 H15.5 A3.5,3.5 0 0 1 15.5,67.5 Z"
                android:strokeColor="@color/scan7_ground"
                android:strokeWidth="2" />
        </group>
    </group>
</vector>
