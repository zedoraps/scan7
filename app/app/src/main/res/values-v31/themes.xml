<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen: brand ground behind the adaptive launcher icon. -->
    <style name="Theme.Scan7" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/scan7_ground</item>
        <item name="android:colorBackground">@color/scan7_ground</item>
        <item name="android:colorAccent">@color/scan7_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/scan7_ground</item>
    </style>
</resources>
