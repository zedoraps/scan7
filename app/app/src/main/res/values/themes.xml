<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme only; the UI is Compose (ui/theme/Theme.kt). Dark, with the brand ground as
        window background so there is no white flash before the first Compose frame.
    -->
    <style name="Theme.Scan7" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/scan7_ground</item>
        <item name="android:colorBackground">@color/scan7_ground</item>
        <item name="android:colorAccent">@color/scan7_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
