<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup on Android 10–11 (Android 12+ uses data_extraction_rules.xml).
    Backed up: the Room database (players, games, settings) and the shared preferences (camera zoom).
    Not backed up: files/ (debug photos) and caches. Training scans live in shared storage
    (Pictures/ and Documents/ "Scan7 Training"), which app backup never covers.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
