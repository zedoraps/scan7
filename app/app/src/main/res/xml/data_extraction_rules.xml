<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device transfer. Same content as backup_rules.xml: the Room database
    (players, games, settings) and the shared preferences (camera zoom); not files/ (debug photos)
    or caches. Training scans live in shared storage, which app backup never covers.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
